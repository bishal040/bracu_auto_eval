{
  "manifest_version": 3,
  "name": "BRACU Auto Evaluator",
  "version": "3.0.0",
  "description": "Auto-complete BRAC University course evaluations",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://courseevaluation.bracu.ac.bd/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://courseevaluation.bracu.ac.bd/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
